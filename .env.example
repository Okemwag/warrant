# Copy to .env and fill in. Never commit .env.

# Postgres (docker compose exposes it on 5433)
DATABASE_URL=postgres://warrant:warrant@localhost:5433/warrant?sslmode=disable
WARRANT_TEST_DATABASE_URL=postgres://warrant:warrant@localhost:5433/warrant_test?sslmode=disable

# API
WARRANT_ADDR=:8080
# Bearer tokens. The console token manages permissions and approves purchases.
# The agent token can only evaluate (and later check out). Use long random values.
WARRANT_CONSOLE_TOKEN=sagtyghewi348resl
WARRANT_AGENT_TOKEN=cfgbhnjsdx76weedsh

# ed25519 signing key: base64 of a 32-byte seed. Generate with: make keygen
WARRANT_SIGNING_KEY=rI2s8tdr4KhHJEoqygLk9z3529LRSe6xUj65N+VEWkU=

# Where PayPal sends the buyer back to (this server's public URL).
WARRANT_PUBLIC_URL=http://localhost:8080
# Where PayPal return pages link back to. "/" when the server hosts the Console;
# http://localhost:5173 when running the Console dev server.
WARRANT_CONSOLE_URL=/
# Built Console to serve at "/" (make console). Skipped if missing.
WARRANT_CONSOLE_DIR=console/dist
# For the agent MCP server (bin/warrant-mcp).
WARRANT_API_URL=http://localhost:8080

WARRANT_RESERVATION_TTL=15m
WARRANT_PRICE_TOLERANCE_CENTS=0

# PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox webhook ID (developer dashboard -> your app -> Webhooks), pointing at
# $WARRANT_PUBLIC_URL/v1/webhooks/paypal. Optional locally: checkout also asks PayPal directly.
PAYPAL_WEBHOOK_ID=
# approve (Mode A) or vault (Mode B)
PAYPAL_MODE=approve

# Claude: plain-language permission compiler (optional; templates work without it)
ANTHROPIC_API_KEY=
WARRANT_LLM_MODEL=claude-opus-5-5
